@using scheapp.app.Models.API
@model Business

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add New Business";
}

<h1>Add New Business</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form id="frmNewBusiness">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>           
            <div class="form-group mb-2">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Website" class="control-label"></label>
                <input asp-for="Website" class="form-control" />
                <span asp-validation-for="Website" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="StreetOne" class="control-label"></label>
                <input asp-for="StreetOne" class="form-control" />
                <span asp-validation-for="StreetOne" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="StreetTwo" class="control-label"></label>
                <input asp-for="StreetTwo" class="form-control" />
                <span asp-validation-for="StreetTwo" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="City" class="control-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="State" class="control-label"></label>
                <input asp-for="State" class="form-control" />
                <span asp-validation-for="State" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="ZipCode" class="control-label"></label>
                <input asp-for="ZipCode" class="form-control" />
                <span asp-validation-for="ZipCode" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Country" class="control-label"></label>
                <input asp-for="Country" class="form-control" />
                <span asp-validation-for="Country" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Lat" class="control-label"></label>
                <input asp-for="Lat" class="form-control" />
                <span asp-validation-for="Lat" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Long" class="control-label"></label>
                <input asp-for="Long" class="form-control" />
                <span asp-validation-for="Long" class="text-danger"></span>
            </div>
            <div class="form-group mb-2 form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>
            <div class="form-group mb-2">
                <input type="button" value="CreateNewBusiness" onclick="postData();" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
    async function getData() {
      const url = "/admin/GetMessage";
      try {
        const response = await fetch(url);
        if (!response.ok) {
          throw new Error(`Response status: ${response.status}`);
        }
        const json = await response.json();
        console.log(json);
      } catch (error) {
        console.error(error.message);
      }
    }
      async function postData() {
        ////check if aspnet auto validation error
        if ($('form').valid()) {
           const swalConfrim =  await Swal.fire({
                title: "Are you sure?",
                text: "You will be adding new availability to schedule appointment system!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, create it!"
            })

            if (swalConfrim.isConfirmed) {
                const url = "/admin/CreateNewBusiness";
                try {
                    const newBusinessForm = document.getElementById('frmNewBusiness');
                    const formData = new FormData(newBusinessForm);
                    const jsonFormData = {};
                    formData.forEach((value, key) => {
                        jsonFormData[key] = value;
                    });
                    console.log(jsonFormData);
                    const response = await fetch(url,{
                                                    method: "POST",
                                                    headers: { 'Content-Type': 'application/json' },
                                                    body: JSON.stringify(jsonFormData)
                                                });
                    if (!response.ok) {
                    throw new Error(`Response status: ${response.status}`);
                    }
                    const jsonResponseData =  await response.json();

                    //process data here

                    console.log(jsonResponseData);
                } catch (error) {
                    console.error(error.message);
                }
            }
        } else {
            
             // There are validation errors
            console.log('Validation errors exist on the form.');
        }

        
      
    }
</script>

